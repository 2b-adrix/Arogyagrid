  <diagram id="arogyagrid-architecture" name="ArogyaGrid Complete System Design">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= SYSTEM CONTAINERS ================= -->

        <!-- 1. ANDROID CLIENT CONTAINER -->
        <mxCell id="c_android" value="ANDROID CLIENT LAYER (Kotlin + Jetpack Compose)" style="swimlane;whiteSpace=wrap;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;fillColor=#E0F2F1;strokeColor=#00695C;fontStyle=1;fontSize=14;fontColor=#004D40;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="740" as="geometry" />
        </mxCell>

        <!-- 2. NETWORK & TRANSPORT CONTAINER -->
        <mxCell id="c_network" value="NETWORK &amp; API TRANSPORT LAYER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#37474F;fontStyle=1;fontSize=14;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="240" height="740" as="geometry" />
        </mxCell>

        <!-- 3. NODE.JS BACKEND CONTAINER -->
        <mxCell id="c_backend" value="NODE.JS &amp; EXPRESS BACKEND SERVER (Port 5000 / Render)" style="swimlane;whiteSpace=wrap;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=14;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="420" height="740" as="geometry" />
        </mxCell>

        <!-- 4. DATABASE & AI LAYER CONTAINER -->
        <mxCell id="c_cloud" value="CLOUD DATABASE &amp; AI INTELLIGENCE LAYER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=14;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="1200" y="40" width="360" height="740" as="geometry" />
        </mxCell>

        <!-- ================= ANDROID INTERNAL COMPONENTS ================= -->

        <mxCell id="ui_views" value="UI Presentation Views (Jetpack Compose)&#xa;--------------------------------------&#xa;• Center Screen (Healthcare Command Dashboard)&#xa;• Risk Screen (Stockout Probability &amp; Alerts)&#xa;• Inventory Screen (Batch Balances &amp; Transactions)&#xa;• Approval Screen (Inter-Facility Redistribution)&#xa;• Forecast Screen (7-Day Demand Curve Chart)&#xa;• AI Copilot Assistant Screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2DFDB;strokeColor=#00796B;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="viewmodels" value="ViewModels &amp; Use Cases Layer&#xa;-----------------------------&#xa;• DashboardViewModel (GetDashboardDataUseCase)&#xa;• InventoryViewModel (RecordTransactionUseCase)&#xa;• RiskViewModel (GetRisksUseCase)&#xa;• RedistributionViewModel (ApproveTransferUseCase)&#xa;• AiAssistantViewModel (AskGeminiUseCase)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#80CBC4;strokeColor=#004D40;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="repositories" value="Repository Data Layer&#xa;---------------------&#xa;• FacilityRepositoryImpl&#xa;• InventoryRepositoryImpl&#xa;• RiskRepositoryImpl&#xa;• RedistributionRepositoryImpl&#xa;• AiRepositoryImpl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4DB6AC;strokeColor=#004D40;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="room_db" value="Local Cache: Room SQLite Database&#xa;---------------------------------&#xa;• FacilityDao | InventoryDao | RiskDao&#xa;• AlertDao | RedistributionDao&#xa;* Ensures instant UI rendering &amp; offline capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00897B;strokeColor=#004D40;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="retrofit" value="Network Engine: Retrofit 2 + OkHttp&#xa;----------------------------------&#xa;• ApiService.kt&#xa;• NetworkClient.kt (BaseUrl: 127.0.0.1:5000 / Render)&#xa;• MockApiInterceptor (Bypassed for live /api/ routes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00695C;strokeColor=#004D40;fontSize=11;fontColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- ================= NETWORK CONNECTIONS ================= -->

        <mxCell id="adb_tunnel" value="ADB Reverse Tunnel&#xa;(tcp:5000 ➔ tcp:5000)&#xa;OR&#xa;HTTPS Render Cloud" style="rhombus;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="180" height="160" as="geometry" />
