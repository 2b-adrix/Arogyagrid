        <mxCell id="express_routes" value="Express API Routers (/api/)&#xa;--------------------------&#xa;• authRouter (/api/auth/session)&#xa;• facilitiesRouter (/api/facilities &amp; /alerts)&#xa;• suppliesRouter (/api/supplies &amp; /transaction)&#xa;• risksRouter (/api/risks - Mathematical Engine)&#xa;• redistributionRouter (/api/redistribution/approve/reject)&#xa;• aiRouter (/api/ai/chat - Context Integrator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="380" height="150" as="geometry" />
